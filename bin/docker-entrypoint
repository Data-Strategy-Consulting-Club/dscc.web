#!/bin/bash -e

# Ensure storage, tmp, and log directories exist and have proper permissions
mkdir -p /rails/storage /rails/tmp /rails/log

if [ "$(id -u)" = "0" ]; then
  chown -R rails:rails /rails/storage /rails/tmp /rails/log 2>/dev/null || true
  chmod -R 775 /rails/storage /rails/tmp /rails/log 2>/dev/null || true
fi

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  if [ "$(id -u)" = "0" ]; then
    gosu rails ./bin/rails db:prepare
  else
    ./bin/rails db:prepare
  fi
fi

if [ "$(id -u)" = "0" ]; then
  exec gosu rails "${@}"
else
  exec "${@}"
fi
