<% content_field = ->(form, record) do %>
  <% if record.file.attached? %>
    <div class="mb-2">
      <%= image_tag record.file, class: "max-h-24 w-auto rounded border" %>
    </div>
  <% end %>

  <% if %w[trusted_by gallery].include?(record.section) && record.key.starts_with?("image_") %>
    <div class="flex items-center gap-4">
      <div class="flex-1">
        <%= form.file_field "contents[#{record.id}][file]", accept: ".jpg,.jpeg,.png,.svg,.webp",
            class: "pl-3 sm:pl-5 block w-full text-xs sm:text-sm text-gray-500 file:mr-2 sm:file:mr-4 file:py-1.5 sm:file:py-2 file:px-3 sm:file:px-4 file:rounded file:border-0 file:text-xs sm:file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
      </div>
      <%= link_to "Remove", remove_image_admin_content_path(id: record.id),
          data: { turbo_method: :delete, turbo_confirm: "Remove this image?" },
          class: "text-xs sm:text-sm text-red-600 hover:text-red-800 whitespace-nowrap" %>
    </div>
    <%= form.hidden_field "contents[#{record.id}][content]", value: "" %>

  <% elsif image_key?(record.key) %>
    <div class="flex items-center gap-4 py-2">
      <div class="flex-1">
        <%= form.file_field "contents[#{record.id}][file]", accept: ".jpg,.jpeg,.png,.svg",
            class: "pl-3 sm:pl-5 block w-full text-xs sm:text-sm text-gray-500 file:mr-2 sm:file:mr-4 file:py-1.5 sm:file:py-2 file:px-3 sm:file:px-4 file:rounded file:border-0 file:text-xs sm:file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
      </div>
    </div>
    <%= form.hidden_field "contents[#{record.id}][content]", value: record.content %>

  <% elsif short_text_field?(record) %>
    <%= form.text_field "contents[#{record.id}][content]", value: record.content,
        class: "w-full rounded border border-gray-300 px-3 py-2 text-xs sm:text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>

  <% else %>
    <%= form.text_area "contents[#{record.id}][content]", value: record.content,
        rows: [record.content.to_s.lines.length + 1, 3].max,
        class: "w-full rounded border border-gray-300 px-3 py-2 text-xs sm:text-sm font-mono focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  <% end %>
<% end %>

<div class="max-w-7xl mx-auto px-4 py-8">
  <h1 class="text-xl sm:text-2xl font-bold mb-6 sm:mb-8">Site Content</h1>

  <%= form_with url: admin_content_path, method: :patch, local: true, html: { multipart: true, class: "space-y-8" } do |form| %>
    <% @sections.each do |section, records| %>
      <details class="bg-white rounded-lg border border-gray-200 shadow-sm" data-controller="admin-details" data-admin-details-key-value="<%= section %>">
        <summary class="px-4 py-3 sm:px-6 sm:py-4 cursor-pointer hover:bg-gray-50 font-semibold text-base sm:text-lg capitalize">
          <%= section.tr("_", " ") %>
        </summary>
        <div class="px-4 pb-4 sm:px-6 sm:pb-6 space-y-4">
          <% if section == "three_reals" %>
            <% rows = { "client" => "Row 1", "growth" => "Row 2", "connection" => "Row 3" } %>
            <% current_row = nil %>
            <% records.each do |record| %>
              <% row_prefix = rows.keys.find { |p| record.key.start_with?("#{p}_image_") } %>
              <% if row_prefix && row_prefix != current_row %>
                <h4 class="text-xs sm:text-sm font-semibold text-gray-500 uppercase tracking-wide <%= current_row.nil? ? 'pt-2' : 'pt-6' %> mb-2.5 sm:mb-3"><%= rows[row_prefix] %></h4>
                <% current_row = row_prefix %>
              <% end %>
              <div class="border-b border-gray-100 pb-4 last:border-b-0 last:pb-0">
                <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1">
                  <%= admin_content_label(record) %>
                </label>
                <%= content_field.call(form, record) %>
              </div>
            <% end %>
          <% elsif section == "our_services" %>
            <% header_record = records.find { |r| r.key == "header" } %>
            <% if header_record %>
              <div class="border-b border-gray-100 pb-4">
                <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1">
                  Section Header Description
                </label>
                <%= content_field.call(form, header_record) %>
              </div>
            <% end %>

            <div class="space-y-6 pt-2">
              <% (1..3).each do |i| %>
                <% card_records = records.select { |r| r.key.start_with?("card#{i}_") } %>
                <% if card_records.any? %>
                  <div class="bg-gray-50/80 p-4 sm:p-5 rounded-lg border border-gray-200 space-y-4">
                    <h4 class="text-sm sm:text-base font-bold text-gray-900 flex items-center gap-2">
                      <span class="inline-flex items-center justify-center w-6 h-6 text-xs font-bold text-blue-700 bg-blue-100 rounded-full"><%= i %></span>
                      Card <%= i %> Details
                    </h4>

                    <div class="space-y-4">
                      <% 
                        fields = [
                          { key: "card#{i}_heading", label: "Card header", hint: nil },
                          { key: "card#{i}_desc", label: "Card description", hint: nil },
                          { key: "card#{i}_features", label: "Card feature", hint: "Free text — HTML and inline CSS supported (e.g. <ul>, <li>, <span style=\"...\">)" },
                          { key: "card#{i}_footer", label: "Card footer", hint: nil }
                        ]
                      %>

                      <% fields.each do |f| %>
                        <% record = records.find { |r| r.key == f[:key] } %>
                        <% if record %>
                          <div>
                            <div class="flex items-baseline justify-between mb-1">
                              <label class="block text-xs sm:text-sm font-medium text-gray-700">
                                <%= f[:label] %>
                              </label>
                              <% if f[:hint] %>
                                <span class="text-[11px] sm:text-xs text-gray-500"><%= f[:hint] %></span>
                              <% end %>
                            </div>
                            <%= content_field.call(form, record) %>
                          </div>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% elsif %w[trusted_by gallery].include?(section) %>
            <div id="<%= section %>_records" class="space-y-4">
              <% records.each do |record| %>
                <%= render "admin/content/image_row", record: record %>
              <% end %>
            </div>
            <%= render "admin/content/section_footer", section: section, records: records %>
          <% else %>
            <% records.each do |record| %>
              <div class="border-b border-gray-100 pb-4 last:border-b-0 last:pb-0">
                <label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1">
                  <%= admin_content_label(record) %>
                </label>
                <%= content_field.call(form, record) %>
              </div>
            <% end %>
          <% end %>
        </div>
      </details>
    <% end %>

    <div class="flex items-center justify-end bg-white p-4 sm:p-6 rounded-lg border border-gray-200 shadow-sm">
      <%= form.submit "Save All Changes",
          class: "px-4 py-2.5 sm:px-6 sm:py-3 bg-blue-700 text-white text-sm sm:text-base font-medium rounded-lg hover:bg-blue-800 cursor-pointer" %>
    </div>
  <% end %>
</div>
