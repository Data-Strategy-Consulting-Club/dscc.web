<% content_field = ->(form, record) do %>
  <% if record.file.attached? %>
    <div class="mb-2">
      <%= image_tag record.file, class: "max-h-24 w-auto rounded border" %>
    </div>
  <% end %>

  <% if record.section == "trusted_by" && record.key.starts_with?("image_") %>
    <div class="flex items-center gap-4">
      <div class="flex-1">
        <%= form.file_field "contents[#{record.id}][file]", accept: ".jpg,.jpeg,.png,.svg",
            class: "pl-5 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
      </div>
      <%= link_to "Remove", remove_image_admin_content_path(id: record.id),
          data: { turbo_method: :delete, turbo_confirm: "Remove this image?" },
          class: "text-sm text-red-600 hover:text-red-800 whitespace-nowrap" %>
    </div>
    <%= form.hidden_field "contents[#{record.id}][content]", value: "" %>

  <% elsif image_key?(record.key) %>
    <div class="flex items-center gap-4 py-2">
      <div class="flex-1">
        <%= form.file_field "contents[#{record.id}][file]", accept: ".jpg,.jpeg,.png,.svg",
            class: "pl-5 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
      </div>
    </div>
    <%= form.hidden_field "contents[#{record.id}][content]", value: record.content %>

  <% elsif short_text_field?(record) %>
    <%= form.text_field "contents[#{record.id}][content]", value: record.content,
        class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>

  <% else %>
    <%= form.text_area "contents[#{record.id}][content]", value: record.content,
        rows: [record.content.to_s.lines.length + 1, 3].max,
        class: "w-full rounded border border-gray-300 px-3 py-2 text-sm font-mono focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  <% end %>
<% end %>

<div class="max-w-7xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-8">Site Content</h1>

  <%= form_with url: admin_content_path, method: :patch, local: true, html: { multipart: true, class: "space-y-8" } do |form| %>
    <% @sections.each do |section, records| %>
      <details class="bg-white rounded-lg border border-gray-200 shadow-sm">
        <summary class="px-6 py-4 cursor-pointer hover:bg-gray-50 font-semibold text-lg capitalize">
          <%= section.tr("_", " ") %>
        </summary>
        <div class="px-6 pb-6 space-y-4">
          <% if section == "three_reals" %>
            <% rows = { "client" => "Row 1", "growth" => "Row 2", "connection" => "Row 3" } %>
            <% current_row = nil %>
            <% records.each do |record| %>
              <% row_prefix = rows.keys.find { |p| record.key.start_with?("#{p}_image_") } %>
              <% if row_prefix && row_prefix != current_row %>
                <% current_row = row_prefix %>
                <h4 class="text-sm font-semibold text-gray-500 uppercase tracking-wide pt-4 -mb-2"><%= rows[row_prefix] %></h4>
              <% end %>
              <div class="border-b border-gray-100 pb-4 last:border-b-0 last:pb-0">
                <label class="block text-sm font-medium text-gray-700 mb-1">
                  <%= record.key.humanize %>
                </label>
                <%= content_field.call(form, record) %>
              </div>
            <% end %>
          <% else %>
            <% records.each do |record| %>
              <div class="border-b border-gray-100 pb-4 last:border-b-0 last:pb-0">
                <label class="block text-sm font-medium text-gray-700 mb-1">
                  <%= record.key.humanize %>
                </label>
                <%= content_field.call(form, record) %>
              </div>
            <% end %>
          <% end %>
          <% if section == "trusted_by" %>
            <div class="pt-2">
              <%= link_to "+ Add Image", add_image_admin_content_path,
                  data: { turbo_method: :post },
                  class: "text-sm text-blue-600 hover:text-blue-800 font-medium" %>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>

    <div class="flex items-center justify-end bg-white p-6 rounded-lg border border-gray-200 shadow-sm">
      <%= form.submit "Save All Changes",
          class: "px-6 py-3 bg-blue-700 text-white font-medium rounded-lg hover:bg-blue-800 cursor-pointer" %>
    </div>
  <% end %>
</div>
