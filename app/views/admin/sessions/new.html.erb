<div class="min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-sm">
    <h1 class="text-2xl font-bold text-center mb-8">Admin Login</h1>

    <% if flash[:alert] %>
      <div class="bg-red-100 text-red-800 px-4 py-3 rounded-lg mb-6">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: admin_login_path, local: true, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :username, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :username, autocomplete: "username",
            class: "w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= form.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.password_field :password, autocomplete: "current-password",
            class: "w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <%= form.submit "Log in",
          class: "w-full px-4 py-3 bg-blue-700 text-white font-medium rounded-lg hover:bg-blue-800 cursor-pointer" %>
    <% end %>
  </div>
</div>
