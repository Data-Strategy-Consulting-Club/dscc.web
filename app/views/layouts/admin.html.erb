<!DOCTYPE html>
<html>
  <head>
    <title>Admin — DSCC</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :tailwind, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="bg-gray-50 text-gray-900" data-admin="true">
    <nav class="bg-white border-b border-gray-200 fixed w-full z-20 top-0">
      <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-3 sm:gap-4">
          <a href="/" class="text-xs sm:text-sm text-gray-500 hover:text-gray-700">← Back to site</a>
          <span class="text-base sm:text-lg font-bold">Admin</span>
        </div>
        <div class="flex items-center gap-3 sm:gap-4">
          <span class="hidden xs:inline text-xs sm:text-sm text-gray-400">Site Content</span>
          <%= button_to "Logout", admin_logout_path, method: :delete,
              class: "text-xs sm:text-sm text-red-600 hover:text-red-800 font-medium",
              data: { turbo: false } %>
        </div>
      </div>
    </nav>

    <main class="pt-16 pb-12">
      <%= render "shared/toast" %>
      <%= yield %>
    </main>
  </body>
</html>
