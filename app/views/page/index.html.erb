<section id="contact" class="min-h-screen flex flex-col justify-center px-6 lg:px-20 py-20">
  <div class="max-w-6xl mx-auto w-full">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-heading mb-4">Contact Us</h2>
      <p class="text-lg text-body">Have a question or want to work with us? We'd love to hear from you.</p>
    </div>

    <div class="flex flex-col lg:flex-row gap-12 lg:gap-20">
      <div class="lg:w-5/12 text-left">
        <h3 class="text-2xl font-bold text-heading mb-4">Get in Touch</h3>
        <p class="text-body mb-8 leading-relaxed">
          Whether you're a student looking to join, a client with a project, or just want to learn more — we're here to help.
        </p>

        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <svg class="w-6 h-6 text-brand flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21.5 6.5v11a1 1 0 0 1-1 1h-17a1 1 0 0 1-1-1v-11m19 0-9 6.5-9-6.5m19 0h-19"/></svg>
            <div>
              <p class="text-sm text-body">Email</p>
              <a href="mailto:hello@dscc.org" class="text-heading hover:text-brand font-medium">hello@dscc.org</a>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <svg class="w-6 h-6 text-brand flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.4 5.6a8.8 8.8 0 0 1 0 12.8M15.3 8.7a4.8 4.8 0 0 1 0 6.6M12 12h.01M12 12h.01M9.7 8.7a4.8 4.8 0 0 0 0 6.6M5.6 5.6a8.8 8.8 0 0 0 0 12.8"/></svg>
            <div>
              <p class="text-sm text-body">Phone</p>
              <span class="text-heading font-medium">+1 (555) 000-0000</span>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:w-7/12">
        <%= form_with url: contact_path, local: true, class: "space-y-5" do |form| %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :name, "Name", class: "block text-sm font-medium text-heading mb-1.5" %>
              <%= form.text_field :name, required: true, placeholder: "Your name", class: "w-full rounded-base border border-default bg-neutral-primary-soft text-body px-4 py-2.5 focus:ring-2 focus:ring-brand-medium focus:border-brand outline-none" %>
            </div>
            <div>
              <%= form.label :email, "Email", class: "block text-sm font-medium text-heading mb-1.5" %>
              <%= form.email_field :email, required: true, placeholder: "your@email.com", class: "w-full rounded-base border border-default bg-neutral-primary-soft text-body px-4 py-2.5 focus:ring-2 focus:ring-brand-medium focus:border-brand outline-none" %>
            </div>
            <div>
              <%= form.label :organization, "Organization", class: "block text-sm font-medium text-heading mb-1.5" %>
              <%= form.text_field :organization, placeholder: "Company or school", class: "w-full rounded-base border border-default bg-neutral-primary-soft text-body px-4 py-2.5 focus:ring-2 focus:ring-brand-medium focus:border-brand outline-none" %>
            </div>
            <div>
              <%= form.label :phone, "Phone", class: "block text-sm font-medium text-heading mb-1.5" %>
              <%= form.telephone_field :phone, placeholder: "+1 (555) 000-0000", class: "w-full rounded-base border border-default bg-neutral-primary-soft text-body px-4 py-2.5 focus:ring-2 focus:ring-brand-medium focus:border-brand outline-none" %>
            </div>
          </div>
          <div>
            <%= form.label :message, "Message", class: "block text-sm font-medium text-heading mb-1.5" %>
            <%= form.text_area :message, rows: 5, required: true, placeholder: "Tell us about your project or question...", class: "w-full rounded-base border border-default bg-neutral-primary-soft text-body px-4 py-2.5 focus:ring-2 focus:ring-brand-medium focus:border-brand outline-none resize-none" %>
          </div>
          <div class="text-right">
            <%= form.submit "Send Message", class: "text-white bg-brand hover:bg-brand-strong box-border border border-transparent focus:ring-4 focus:ring-brand-medium shadow-xs font-medium rounded-base text-base px-6 py-3 focus:outline-none cursor-pointer" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
