<section id="overview" class="relative min-h-[calc(100dvh+80px)] flex flex-col lg:flex-row justify-center pt-26 px-10 lg:items-start lg:justify-between">
  <div id="overview-bg" data-controller="vanta-topology" class="absolute inset-0 -z-20"></div>
  <div class="relative flex flex-col lg:items-start lg:text-start lg:mt-30 lg:mr-30">
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2
             w-[500px] h-[500px] sm:w-[800px] sm:h-[800px]
             rounded-full
             bg-[radial-gradient(circle,_rgba(255,255,255,1)_0%,_rgba(255,255,255,0.9)_30%,_rgba(255,255,255,0)_70%)]
             -z-10
             pointer-events-none"
    ></div>
    <h1 id="overview" class="mb-4 sm:mb-6 text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-tight text-heading"><%= sc("overview", "h1") %></h1>
    <p class="mb-5 sm:mb-6 text-sm sm:text-base md:text-lg lg:text-xl font-normal text-body"><%= sc("overview", "tagline") %></p>
    <a href="#contact" class="inline-block self-center lg:self-start text-white bg-brand hover:bg-brand-strong box-border border border-transparent focus:ring-4 focus:ring-brand-medium shadow-xs font-medium rounded-base text-sm sm:text-base px-4 py-2.5 sm:px-5 sm:py-3 focus:outline-none"><%= sc("navbar", "contact_button") %></a>
  </div>
  <div class="relative lg:w-100 mt-10">
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2
             w-[500px] h-[500px] sm:w-[1000px] sm:h-[800px]
             rounded-full
             bg-[radial-gradient(ellipse_at_center,_rgba(255,255,255,1)_0%,_rgba(255,255,255,0.9)_30%,_rgba(255,255,255,0)_70%)]
             -z-10
             pointer-events-none"
    ></div>
    <p class="opacity-90 lg:opacity-100 text-start text-body text-[12px] sm:text-xs md:text-sm">
      <%= sc("overview", "sidebar") %>
    </p>
  </div>
  <div
    class="absolute bottom-0 left-0 w-full h-40
          bg-gradient-to-b from-transparent to-white
          pointer-events-none"
  ></div>
</section>

<section
  id="who-we-are"
  class="flex flex-col lg:flex-row justify-between items-center px-6 lg:px-24 gap-8 lg:gap-12 min-h-screen"
>
  <!-- Content -->
  <div class="order-2 lg:order-1 flex-1 max-w-xl">
    <h2 class="mb-4 sm:mb-6 md:mb-8 text-2xl sm:text-3xl md:text-4xl font-bold text-heading">
      <%= sc("navbar", "who_we_are_label") %>
    </h2>

    <p class="text-start text-body text-sm sm:text-base leading-relaxed">
      <%= sc("who_we_are", "body") %>
    </p>
  </div>

  <!-- Image -->
  <%= link_to gallery_path,
      class: "order-1 lg:order-2 w-full max-w-[600px] h-64 sm:h-80 lg:w-[600px] lg:h-[400px] flex items-center justify-center bg-neutral-quaternary rounded-base flex-shrink-0 overflow-hidden shadow-sm transition-all duration-300 transform hover:scale-[1.03] hover:shadow-lg active:scale-95 cursor-pointer block group" do %>
    <% if (img = sc_image("who_we_are", "image", class: "w-full h-full object-cover transition-transform duration-300 group-hover:scale-105")) %>
      <%= img %>
    <% else %>
      <svg
        class="w-12 h-12 text-fg-disabled animate-pulse transition-transform duration-300 group-hover:scale-110"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="m3 16 5-7 6 6.5m6.5 2.5L16 13l-4.286 6M14 10h.01M4 19h16a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1Z"
        />
      </svg>
    <% end %>
  <% end %>
</section>

