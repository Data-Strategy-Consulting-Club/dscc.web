<section class="flex flex-col justify-center h-screen px-40 py-20">
  <!-- Header -->
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="mb-6 text-4xl font-bold text-heading">
      Our Services
    </h2>

    <p class="text-lg text-body leading-8">
      We help organizations unlock value from their data, automate
      business processes, and leverage artificial intelligence to drive
      smarter decisions, operational excellence, and sustainable growth.
    </p>
  </div>

  <!-- Service Cards -->
  <div class="grid grid-cols-1 gap-8 mt-16 md:grid-cols-2 xl:grid-cols-3">

    <!-- Analytics -->
    <div class="p-8 border rounded-base bg-neutral-primary-soft border-default shadow-xs">
      <h3 class="mb-2 text-2xl font-bold text-heading">
        Analytics & Decision Intelligence
      </h3>

      <p class="mb-6 text-body italic">
        Define strategy, optimize operations, and offer clear advice for
        complex decisions.
      </p>

      <ul class="space-y-3 text-body">
        <li>✓ Foresight, Not Guesswork</li>
        <li>✓ AI-Powered Predictive Models</li>
        <li>✓ Decision Dashboards & Reporting</li>
        <li>✓ Risk & Opportunity Detection</li>
        <li>✓ Delivered AI Intelligence Asset</li>
      </ul>

      <div class="pt-6 mt-6 border-t border-default">
        <p class="text-sm text-body">
          Focused on unlocking business insights and leveraging AI for
          smarter decisions.
        </p>
      </div>
    </div>

    <!-- Automation -->
    <div class="p-8 border rounded-base bg-neutral-primary-soft border-default shadow-xs">
      <h3 class="mb-2 text-2xl font-bold text-heading">
        Automation & AI Integration
      </h3>

      <p class="mb-6 text-body italic">
        Design plans to transform core processes and implement AI tools
        that cut manual costs.
      </p>

      <ul class="space-y-3 text-body">
        <li>✓ Reduced Manual Effort</li>
        <li>✓ Process Mapping & Optimization</li>
        <li>✓ AI Service & Architecture Design</li>
        <li>✓ CRM / ERP Integration</li>
        <li>✓ Cost-Optimized Deployment</li>
      </ul>

      <div class="pt-6 mt-6 border-t border-default">
        <p class="text-sm text-body">
          Focused on automating workflows and improving productivity.
        </p>
      </div>
    </div>

    <!-- Data -->
    <div class="p-8 border rounded-base bg-neutral-primary-soft border-default shadow-xs">
      <h3 class="mb-2 text-2xl font-bold text-heading">
        Data Strategy & Transformation
      </h3>

      <p class="mb-6 text-body italic">
        Design plans to modernize data practices and establish governance
        standards.
      </p>

      <ul class="space-y-3 text-body">
        <li>✓ Data Strategy & Roadmap</li>
        <li>✓ Centralized Data Foundation</li>
        <li>✓ Historical Data Standardization</li>
        <li>✓ ETL / ELT Pipeline Development</li>
        <li>✓ Data Governance & Security</li>
      </ul>

      <div class="pt-6 mt-6 border-t border-default">
        <p class="text-sm text-body">
          Focused on delivering data solutions that transform and drive
          growth.
        </p>
      </div>
    </div>

  </div>
</section>

