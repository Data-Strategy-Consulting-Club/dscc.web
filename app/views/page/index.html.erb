<section id="trusted-by" class="mt-10 mb-16 flex flex-col overflow-hidden">
  <div class="max-w-4xl mx-auto mb-8 sm:mb-12 md:mb-16">
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-heading">
      <%= sc("navbar", "trusted_by_label") %>
    </h2>
  </div>
  <div class="flex justify-center space-y-8 md:space-y-0 md:space-x-8 rtl:space-x-reverse md:flex md:items-center">
    <% SiteContent.by_section("trusted_by").each do |record| %>
      <div class="shrink-0 flex items-center justify-center min-w-20 min-h-10">
        <% if record.file.attached? %>
          <%= image_tag record.file, class: "max-h-10 w-auto h-auto" %>
        <% else %>
          <div class="animate-pulse flex items-center justify-center w-full h-full">
            <svg class="w-11 h-11 text-fg-disabled" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m3 16 5-7 6 6.5m6.5 2.5L16 13l-4.286 6M14 10h.01M4 19h16a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1Z"/></svg>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<section id="contact" class="min-h-screen flex flex-col justify-center px-6 lg:px-20 py-20">
  <div class="max-w-6xl mx-auto w-full">
    <div class="text-center mb-10 sm:mb-16">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-heading mb-2 sm:mb-4"><%= sc("contact_us", "heading") %></h2>
      <p class="text-sm sm:text-base md:text-lg text-body"><%= sc("contact_us", "description") %></p>
    </div>

    <div class="flex flex-col lg:flex-row gap-12 lg:gap-20">
      <div class="lg:w-5/12 text-left">
        <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-heading mb-3 sm:mb-4"><%= sc("contact_us", "get_in_touch") %></h3>
        <p class="text-xs sm:text-sm md:text-base text-body mb-6 sm:mb-8 leading-relaxed">
          <%= sc("contact_us", "help_text") %>
        </p>

        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <svg class="w-6 h-6 text-brand flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21.5 6.5v11a1 1 0 0 1-1 1h-17a1 1 0 0 1-1-1v-11m19 0-9 6.5-9-6.5m19 0h-19"/></svg>
            <div>
              <p class="text-xs sm:text-sm text-body"><%= sc("contact_us", "email_label") %></p>
              <a href="mailto:<%= sc("contact_us", "email_value") %>" class="text-sm sm:text-base text-heading hover:text-brand font-medium"><%= sc("contact_us", "email_value") %></a>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <svg class="w-6 h-6 text-brand flex-shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.4 5.6a8.8 8.8 0 0 1 0 12.8M15.3 8.7a4.8 4.8 0 0 1 0 6.6M12 12h.01M12 12h.01M9.7 8.7a4.8 4.8 0 0 0 0 6.6M5.6 5.6a8.8 8.8 0 0 0 0 12.8"/></svg>
            <div>
              <p class="text-xs sm:text-sm text-body"><%= sc("contact_us", "phone_label") %></p>
              <span class="text-sm sm:text-base text-heading font-medium"><%= sc("contact_us", "phone_value") %></span>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:w-7/12">
        <%= form_with url: contact_path, local: true, class: "space-y-5" do |form| %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :name, sc("contact_us", "name_label"), class: "block text-xs sm:text-sm font-medium text-heading mb-1 sm:mb-1.5" %>
              <%= form.text_field :name, required: true, placeholder: sc("contact_us", "name_placeholder"), class: "w-full rounded-base border border-default bg-neutral-primary-soft text-body text-xs sm:text-sm px-3 py-2 sm:px-4 sm:py-2.5 focus:ring-2 focus:ring-brand-medium focus:border-brand outline-none" %>
            </div>
            <div>
              <%= form.label :email, sc("contact_us", "email_field_label"), class: "block text-xs sm:text-sm font-medium text-heading mb-1 sm:mb-1.5" %>
              <%= form.email_field :email, required: true, placeholder: sc("contact_us", "email_placeholder"), class: "w-full rounded-base border border-default bg-neutral-primary-soft text-body text-xs sm:text-sm px-3 py-2 sm:px-4 sm:py-2.5 focus:ring-2 focus:ring-brand-medium focus:border-brand outline-none" %>
            </div>
            <div>
              <%= form.label :organization, sc("contact_us", "org_label"), class: "block text-xs sm:text-sm font-medium text-heading mb-1 sm:mb-1.5" %>
              <%= form.text_field :organization, placeholder: sc("contact_us", "org_placeholder"), class: "w-full rounded-base border border-default bg-neutral-primary-soft text-body text-xs sm:text-sm px-3 py-2 sm:px-4 sm:py-2.5 focus:ring-2 focus:ring-brand-medium focus:border-brand outline-none" %>
            </div>
            <div>
              <%= form.label :phone, sc("contact_us", "phone_field_label"), class: "block text-xs sm:text-sm font-medium text-heading mb-1 sm:mb-1.5" %>
              <%= form.telephone_field :phone, placeholder: sc("contact_us", "phone_placeholder"), class: "w-full rounded-base border border-default bg-neutral-primary-soft text-body text-xs sm:text-sm px-3 py-2 sm:px-4 sm:py-2.5 focus:ring-2 focus:ring-brand-medium focus:border-brand outline-none" %>
            </div>
          </div>
          <div>
            <%= form.label :message, sc("contact_us", "message_label"), class: "block text-xs sm:text-sm font-medium text-heading mb-1 sm:mb-1.5" %>
            <%= form.text_area :message, rows: 5, required: true, placeholder: sc("contact_us", "message_placeholder"), class: "w-full rounded-base border border-default bg-neutral-primary-soft text-body text-xs sm:text-sm px-3 py-2 sm:px-4 sm:py-2.5 focus:ring-2 focus:ring-brand-medium focus:border-brand outline-none resize-none" %>
          </div>
          <div class="text-right">
            <%= form.submit sc("contact_us", "submit_text"), class: "text-white bg-brand hover:bg-brand-strong box-border border border-transparent focus:ring-4 focus:ring-brand-medium shadow-xs font-medium rounded-base text-sm sm:text-base px-5 py-2.5 sm:px-6 sm:py-3 focus:outline-none cursor-pointer" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
