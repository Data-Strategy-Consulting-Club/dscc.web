<% content_for(:title, "Gallery — DSCC") %>

<div
  data-controller="gallery-draggable"
  data-gallery-draggable-target="canvas"
  class="fixed inset-0 w-screen h-screen bg-dotted-grid overflow-hidden select-none"
  style="width: 100vw; height: 100vh; max-width: 100vw; max-height: 100vh;"
>
  <!-- Layer 1: Watermark (Centered Protected Exclusion Zone) -->
  <div
    data-gallery-draggable-target="watermark"
    class="absolute inset-0 flex items-center justify-center select-none pointer-events-none z-10 px-4"
  >
    <div
      data-gallery-draggable-target="watermarkText"
      class="text-center py-6 px-6 sm:px-10 rounded-3xl"
    >
      <p class="text-sm sm:text-xl md:text-2xl lg:text-3xl xl:text-4xl font-extrabold tracking-widest text-[#9b000a]/20 uppercase mb-1 sm:mb-2 md:mb-3 select-none">
        Welcome to
      </p>
      <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-[9rem] font-black tracking-tight text-[#344d75]/40 select-none">
        DSCC
      </h1>
    </div>
  </div>

  <!-- Layer 2: Pictures (Dynamic Responsive Random Collage) -->
  <% if @gallery_images.present? %>
    <div
      data-gallery-draggable-target="container"
      class="absolute inset-0 z-20 w-full h-full overflow-hidden"
    >
      <% @gallery_images.each do |record| %>
        <div
          data-gallery-draggable-target="item"
          class="photo-card absolute rounded-2xl shadow-md flex items-center justify-center cursor-grab active:cursor-grabbing select-none touch-none hover:shadow-xl transition-shadow group overflow-hidden bg-transparent"
          style="will-change: transform, width, height; opacity: 0;"
          <% if record.file.attached? && record.file.blob.metadata.present? && record.file.blob.metadata["width"].to_i > 0 && record.file.blob.metadata["height"].to_i > 0 %>
            data-aspect-ratio="<%= (record.file.blob.metadata["width"].to_f / record.file.blob.metadata["height"].to_f).round(4) %>"
          <% end %>
        >
          <%= optimized_image_tag record,
                        size: :large,
                        draggable: false,
                        class: "w-full h-full object-cover pointer-events-none select-none rounded-2xl block",
                        loading: "eager",
                        decoding: "async",
                        alt: "DSCC Gallery Photo" %>

          <!-- Corner Resize Handles -->
          <div class="resize-handle se-handle absolute bottom-0 right-0 w-7 h-7 cursor-nwse-resize z-30 touch-none flex items-end justify-end p-1 opacity-0 group-hover:opacity-100 transition-opacity">
            <div class="w-2 h-2 rounded-full bg-neutral-400/70 shadow-sm"></div>
          </div>
          <div class="resize-handle sw-handle absolute bottom-0 left-0 w-7 h-7 cursor-nesw-resize z-30 touch-none flex items-end justify-start p-1 opacity-0 group-hover:opacity-100 transition-opacity">
            <div class="w-2 h-2 rounded-full bg-neutral-400/70 shadow-sm"></div>
          </div>
          <div class="resize-handle ne-handle absolute top-0 right-0 w-7 h-7 cursor-nesw-resize z-30 touch-none flex items-start justify-end p-1 opacity-0 group-hover:opacity-100 transition-opacity">
            <div class="w-2 h-2 rounded-full bg-neutral-400/70 shadow-sm"></div>
          </div>
          <div class="resize-handle nw-handle absolute top-0 left-0 w-7 h-7 cursor-nwse-resize z-30 touch-none flex items-start justify-start p-1 opacity-0 group-hover:opacity-100 transition-opacity">
            <div class="w-2 h-2 rounded-full bg-neutral-400/70 shadow-sm"></div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
