<% content_for(:title, "Gallery — DSCC") %>

<div
  data-controller="gallery-draggable"
  data-gallery-draggable-target="canvas"
  class="min-h-screen w-full bg-dotted-grid relative overflow-hidden"
>
  <!-- Layer 2: Watermark (Centered behind pictures) -->
  <div class="fixed inset-0 flex items-center justify-center select-none pointer-events-none z-10 px-4">
    <div class="text-center">
      <p class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-wider text-neutral-400/35 uppercase mb-2 md:mb-3">
        Welcome to
      </p>
      <h1 class="text-6xl sm:text-8xl md:text-9xl font-black tracking-tight text-brand/25">
        DSCC
      </h1>
    </div>
  </div>

  <!-- Layer 3: Pictures (Draggable & Resizable on top of watermark) -->
  <% if @gallery_images.present? %>
    <div class="relative z-20 pt-24 pb-16 px-6 lg:px-16 min-h-screen">
      <div data-gallery-draggable-target="grid" class="max-w-7xl mx-auto flex flex-wrap items-start justify-center gap-6 relative min-h-[70vh]">
        <% @gallery_images.each do |record| %>
          <div
            data-gallery-draggable-target="item"
            class="group relative rounded-base bg-white border border-default shadow-sm flex items-center justify-center cursor-grab active:cursor-grabbing select-none touch-none w-72"
          >
            <%= image_tag record.file, draggable: false, class: "w-full h-auto object-contain pointer-events-none select-none rounded-base block" %>

            <!-- Corner Resize Handles -->
            <div class="resize-handle se-handle absolute -bottom-2 -right-2 w-4 h-4 bg-white border-2 border-brand rounded-full shadow-md cursor-nwse-resize z-40 hover:scale-125 transition-transform touch-none"></div>
            <div class="resize-handle sw-handle absolute -bottom-2 -left-2 w-4 h-4 bg-white border-2 border-brand rounded-full shadow-md cursor-nesw-resize z-40 hover:scale-125 transition-transform touch-none"></div>
            <div class="resize-handle ne-handle absolute -top-2 -right-2 w-4 h-4 bg-white border-2 border-brand rounded-full shadow-md cursor-nesw-resize z-40 hover:scale-125 transition-transform touch-none"></div>
            <div class="resize-handle nw-handle absolute -top-2 -left-2 w-4 h-4 bg-white border-2 border-brand rounded-full shadow-md cursor-nwse-resize z-40 hover:scale-125 transition-transform touch-none"></div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
